rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // حسابات المستخدمين
    // =========================
    match /users/{userId} {

      // إنشاء الحساب: المستخدم يستطيع إنشاء مستنده الخاص فقط
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.accountNumber is string
                    && request.resource.data.accountNumber.size() > 0;

      // قراءة بيانات الحساب الخاص
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // منع المستخدم من تغيير الرصيد أو uid أو رقم الحساب
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.accountNumber
                       == resource.data.accountNumber
                    && request.resource.data.balance
                       == resource.data.balance;

      // منع حذف الحساب
      allow delete: if false;
    }


    // =========================
    // التحويلات المكتملة
    // =========================
    match /transactions/{transactionId} {

      allow read: if request.auth != null
                  && (
                    resource.data.senderUid == request.auth.uid
                    ||
                    resource.data.receiverUid == request.auth.uid
                  );

      // التحويلات ينشئها الخادم فقط
      allow create, update, delete: if false;
    }


    // =========================
    // طلبات التحويل
    // =========================
    match /transferRequests/{requestId} {

      allow create: if request.auth != null
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount <= 1000000
                    && request.resource.data.receiverAccountNumber is string
                    && request.resource.data.receiverAccountNumber.size() > 0
                    && request.resource.data.receiverAccountNumber.size() <= 30;

      allow read: if request.auth != null
                  && resource.data.senderUid == request.auth.uid;

      // الموافقة والرفض سنضيفهما لاحقًا من لوحة الإدارة
      allow update, delete: if false;
    }
  }
}
